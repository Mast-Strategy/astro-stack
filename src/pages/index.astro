---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const page = (await getEntry('pages', 'home'))!;
const { hero, services } = page.data;
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
	{hero && (
		<section class="relative overflow-hidden bg-stone-900 text-white">
			{hero.image && <img src={hero.image} alt={hero.image_alt ?? ''} class="absolute inset-0 h-full w-full object-cover opacity-60" />}
			<div class="relative mx-auto max-w-5xl px-4 py-24">
				<h1 class="max-w-2xl text-4xl font-bold sm:text-5xl">{hero.headline}</h1>
				{hero.subheadline && <p class="mt-4 max-w-xl text-lg">{hero.subheadline}</p>}
				{hero.cta_label && hero.cta_link && (
					<a href={hero.cta_link} class="mt-8 inline-block rounded bg-orange-600 px-5 py-3 font-semibold hover:bg-orange-700">
						{hero.cta_label}
					</a>
				)}
			</div>
		</section>
	)}
	<section class="mx-auto max-w-3xl space-y-4 px-4 py-12 text-lg">
		<Content />
	</section>
	{services && services.length > 0 && (
		<section class="mx-auto grid max-w-5xl gap-6 px-4 pb-16 sm:grid-cols-3">
			{services.map((service) => (
				<div class="rounded border border-stone-200 bg-white p-6">
					<h2 class="text-lg font-semibold">{service.name}</h2>
					{service.summary && <p class="mt-2 text-stone-600">{service.summary}</p>}
				</div>
			))}
		</section>
	)}
</Layout>
