---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const page = (await getEntry('pages', 'home'))!;
const { heading, image, image_alt } = page.data;
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
	{heading && <h1>{heading}</h1>}
	{image && <Image src={image} alt={image_alt ?? ''} widths={[640, 1280, 1920]} sizes="100vw" loading="eager" />}
	<Content />
</Layout>
