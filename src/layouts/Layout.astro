---
// Base layout. Deliberately unstyled: each client's design is built here and in src/pages.
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { isNonProduction } from '../lib/environment';
import Analytics from '../components/Analytics.astro';

interface Props {
	title: string;
	description?: string;
	// Keep this page out of search results everywhere, e.g. the 404 page.
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const pageTitle = title === 'Home' ? site.site_name : `${title} | ${site.site_name}`;
// Absolute address from siteUrl in site.config.mjs, so previews still point search engines at production.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		{!noindex && <link rel="canonical" href={canonical} />}
		{(noindex || isNonProduction) && <meta name="robots" content="noindex, nofollow" />}
		{/* Renders nothing until a vendor snippet is added as children. See "Analytics" in STAGING.md. */}
		<Analytics />
	</head>
	<body>
		<header>
			<a href="/">{site.site_name}</a>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			{site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
			{site.footer_text && <p>{site.footer_text}</p>}
		</footer>
	</body>
</html>
