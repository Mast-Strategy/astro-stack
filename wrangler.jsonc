{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker name in the Cloudflare dashboard, or Workers Builds fails.
	"name": "ia-stack-test",
	"compatibility_date": "2026-10-14",
	// Static-only site: no "main" Worker script and no Astro Cloudflare adapter.
	"assets": {
		"directory": "./dist",
		// Every page URL ends in a slash, matching trailingSlash: 'always' in astro.config.mjs.
		// Cloudflare adds the slash with a 307 (temporary) redirect; public/_redirects lists 301s.
		"html_handling": "force-trailing-slash",
		// Serve dist/404.html with a real 404 status for unknown URLs.
		"not_found_handling": "404-page"
	},
	// Required by Workers Builds preview builds (`npx wrangler preview`) for every non-main branch.
	// Empty because previews use the same settings as above. Doesn't affect production deploys.
	"previews": {}
}
